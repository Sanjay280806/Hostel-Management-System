# Dependency directories (Never upload these)
node_modules/
jspm_packages/

# Environment variables and secrets (Keeps your API keys safe)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Logs (Generated when running your server)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build and Output folders (If using TypeScript or build tools)
dist/
build/
.out/

# IDE and Text Editor configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj

# Operating system files
.DS_Store
Thumbs.db
